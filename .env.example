# SMTP used by the quote-request form (app/actions/submit-lead.ts)
# cPanel mailbox on the company hosting.
SMTP_HOST=mail.silvotech.eu
SMTP_PORT=465
SMTP_USER=sales@silvotech.eu
SMTP_PASSWORD=

# Where quote requests are delivered. Defaults to SMTP_USER when unset.
LEAD_INBOX=sales@silvotech.eu

# Signing secret for the gated hero video route (app/api/hero-video/route.ts).
VIDEO_TOKEN_SECRET=
