# SMTP used by the quote-request form (app/actions/submit-lead.ts)
# cPanel mailbox on the company hosting.
SMTP_HOST=mail.silvotech.eu
SMTP_PORT=465
SMTP_USER=sales@silvotech.eu
SMTP_PASSWORD=

# Where quote requests are delivered. Defaults to SMTP_USER when unset.
LEAD_INBOX=sales@silvotech.eu

# Vercel Blob store holding the hero clip (lib/hero-video.ts).
# Injected automatically once the Blob store is connected to the project;
# only needed explicitly for local development.
# Without it the hero falls back to a plain navy background.
BLOB_READ_WRITE_TOKEN=
